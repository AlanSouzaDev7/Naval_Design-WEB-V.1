# ════════════════════════════════════════════════════════════════════
# Modelo de configuração do site (v3.0).
# O JEITO SEGURO: "python db/aplicar.py" cria o arquivo de segredos sozinho, com senha aleatória, em
#   %LOCALAPPDATA%\RoyalNavy\consulta.env   (fora do Git e fora do OneDrive; ver config_env.py).
# Alternativa: copie este modelo para ".env" na pasta do projeto (NUNCA vai para o Git; mas cuidado com pastas sincronizadas).
# ════════════════════════════════════════════════════════════════════

# ── Banco de dados: use SEMPRE o papel de leitura (nunca o "postgres") ──
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=navios_leitura
DB_PASSWORD=troque-esta-senha
# prefer = tenta TLS; em banco remoto use: verify-full
DB_SSLMODE=prefer
DB_POOL_MAX=5

# ── Servidor ──
# HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=1
# Hosts aceitos no cabeçalho Host (separe por vírgula). Ao publicar, coloque o seu domínio.
# ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Quantos proxies confiáveis existem na frente (0 = nenhum; 1 = nginx/Cloudflare)
# TRUST_PROXY_HOPS=0
# Ative somente quando o site estiver servido por HTTPS (envia o cabeçalho HSTS)
# RN_HTTPS=1

# ── API ──
# Origens externas autorizadas a chamar a API (lista EXATA, sem "*"); vazio = só o próprio site
# CORS_ORIGINS=https://seu-dominio.com
# Armazenamento do limite de requisições. memory:// serve para 1 processo; em produção use Redis.
# RATELIMIT_STORAGE_URI=memory://
# LOG_LEVEL=INFO
