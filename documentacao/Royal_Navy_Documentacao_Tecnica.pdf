BT 1 0 0 1 6 135.2 Tm /F5+0 7.6 Tf 10.2 TL (function frame\(now\) {) Tj T* (  rafId = requestAnimationFrame\(frame\);) Tj T* (  const dt = Math.min\(\(now - lastTime\) / 1000, 0.05\);   // tempo real, limitado a 50 ms) Tj T* (  if \(initQueue.length\) initEntry\(initQueue.shift\(\)\);    // 1 cena nova por frame) Tj T* (  let active = 0;) Tj T* (  for \(const e of entries\) {) Tj T* (    if \(!e.ready || !e.visible\) continue;) Tj T* (    if \(backgroundPaused && !e.isModal\) continue;) Tj T* (    if \(e.card && e.card.classList.contains\('is-dimmed'\)\) continue;) Tj T* (    if \(e.resizePending && !applyResize\(e\)\) continue;) Tj T* (    e.update\(dt\);  e.renderer.render\(e.scene, e.camera\);  active++;) Tj T* (  }) Tj T* (  if \(!active && !initQueue.length\) stop\(\);              // nada a desenhar -> para o loop) Tj T* (}) Tj T* ET
