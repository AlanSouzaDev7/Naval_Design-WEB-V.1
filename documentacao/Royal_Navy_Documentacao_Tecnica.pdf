BT 1 0 0 1 6 125 Tm /F5+0 7.6 Tf 10.2 TL (// theme.js \017 RNPerf \(simplificado\): janelas de 45 quadros, histerese e per\006odo de espera) Tj T* (function sample\(now\) {) Tj T* (  raf = requestAnimationFrame\(sample\);) Tj T* (  const dt = now - last; last = now;) Tj T* (  if \(dt > 250\) return;                                          // aba voltou do segundo plano: ignora) Tj T* (  acc += dt; if \(++n < 45\) return;) Tj T* (  const avg = acc / n; acc = 0; n = 0;) Tj T* (  cooldown = Math.max\(0, cooldown - 45 * avg\);) Tj T* (  if \(avg > 26 && Perf.level > 0 && cooldown === 0\) { Perf.level--; cooldown = 2500; calmMs = 0; }     // lento) Tj T* (  else if \(avg < 18.5\) { calmMs += 45 * avg;                                                             // folgado) Tj T* (    if \(calmMs > 14000 && Perf.level < 2 && cooldown === 0\) { Perf.level++; cooldown = 4000; calmMs = 0; } }) Tj T* (  else calmMs = 0;) Tj T* (}) Tj T* ET
