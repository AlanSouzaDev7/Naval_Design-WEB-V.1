BT 1 0 0 1 6 216.8 Tm /F5+0 7.6 Tf 10.2 TL (// theme.js \017 RNTheme.set\(\) \(trecho simplificado\)) Tj T* (function set\(mode, opts = {}\) {) Tj T* (  if \(mode !== 'dark' && mode !== 'light'\) return;) Tj T* (  if \(mode === get\(\) || busy\) return;                     // igual ao atual, ou troca em andamento) Tj T* (  if \(opts.instant || REDUCED || !btn\) { apply\(mode\); return; }) Tj T*  T* (  const r = btn.getBoundingClientRect\(\);) Tj T* (  const x = r.left + r.width / 2, y = r.top + r.height / 2;                      // origem = centro do bot\005o) Tj T* (  const radius = Math.hypot\(Math.max\(x, innerWidth - x\), Math.max\(y, innerHeight - y\)\);  // at\022 o canto mais longe) Tj T*  T* (  busy = true;) Tj T* (  if \(typeof document.startViewTransition === 'function'\) {) Tj T* (    root.classList.add\('theme-switching'\);) Tj T* (    const vt = document.startViewTransition\(\(\) => apply\(mode\)\);                  // foto antiga \023 troca \023 foto nova) Tj T* (    vt.ready.then\(\(\) => root.animate\() Tj T* (      { clipPath: [`circle\(0px at ${x}px ${y}px\)`, `circle\(${radius}px at ${x}px ${y}px\)`] },) Tj T* (      { duration: 900, easing: 'cubic-bezier\(.4,0,.2,1\)', pseudoElement: '::view-transition-new\(root\)' }\)\);) Tj T* (    vt.finished.then\(finish, finish\);                                             // libera novo clique) Tj T* (  } else {) Tj T* (    veilTransition\(mode, x, y, radius, finish\);                                   // cortina circular de reserva) Tj T* (  }) Tj T* (}) Tj T* ET
Q
 

