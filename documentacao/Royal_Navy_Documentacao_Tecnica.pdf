BT 1 0 0 1 6 84.2 Tm /F5+0 7.6 Tf 10.2 TL (// war-hero.js \017 m\007quina de estados de cada navio \(trecho simplificado de update\(\)\)) Tj T* (if \(s.state === 'ok'\) {) Tj T* (  s.cool -= dt;) Tj T* (  if \(s.cool <= 0\) { s.cool = rnd\(s.rate[0], s.rate[1]\); fire\(s\); }             // atira) Tj T* (  if \(s.hits >= s.dmgMax\) { s.state = 'sinking'; s.sinkT = 0; }) Tj T* (} else if \(s.state === 'sinking'\) {) Tj T* (  s.sinkT = Math.min\(1, s.sinkT + dt / 9\);                                        // 9 s afundando) Tj T* (  s.sinkY = s.sinkT * s.L * 0.15;  sinkRoll = s.sinkT * 0.4 * s.dir;) Tj T* (  s.alpha = 1 - clamp\(\(s.sinkT - 0.78\) / 0.22, 0, 1\);                             // some no fim) Tj T* ET
