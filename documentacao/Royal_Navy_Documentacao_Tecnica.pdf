BT 1 0 0 1 6 125 Tm /F5+0 7.6 Tf 10.2 TL (-- consulta_api.py: par\027metros SEMPRE separados do SQL \(psycopg envia o texto como par\027metro\)) Tj T* (WITH p AS \(SELECT public.rn_norm\(%\(q\)s::text\) AS q,) Tj T* (                  replace\(replace\(replace\(public.rn_norm\(%\(q\)s::text\), '\\', '\\\\'\), '%%', '\\%%'\), '_', '\\_'\) AS qlike\)) Tj T* (SELECT v.id, v.nome, v.designacao_casco, v.marinha, v.tipo, v.classe, v.guerra, count\(*\) OVER \(\) AS total) Tj T* (FROM public.v_navios v, p) Tj T* (WHERE \(%\(q\)s::text IS NULL OR v.busca_norm LIKE '%%' || p.qlike || '%%' OR word_similarity\(p.q, v.busca_norm\) >= 0.5\)) Tj T* (  AND \(%\(marinha\)s::text IS NULL OR v.marinha = %\(marinha\)s::text\)      -- filtros opcionais, sempre com par\027metro) Tj T* (  AND \(%\(guerra\)s::text  IS NULL OR v.guerra  = %\(guerra\)s::text\)) Tj T* (  AND \(%\(tipo\)s::text    IS NULL OR v.tipo    = %\(tipo\)s::text\)) Tj T* (ORDER BY coalesce\(v.nome_norm = p.q, false\) DESC,                       -- 1\030 nome exato) Tj T* (         coalesce\(v.nome_norm LIKE p.qlike || '%%', false\) DESC,        -- 2\030 nome que come\003a com o texto) Tj T* (         coalesce\(word_similarity\(p.q, v.busca_norm\), 0\) DESC, v.nome   -- 3\030 mais parecido) Tj T* (LIMIT %\(lim\)s OFFSET %\(off\)s) Tj T* ET
Q
